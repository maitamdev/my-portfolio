# Optional multiplayer backend (whispers + circuit leaderboard). Leave empty for static deploy.
VITE_SERVER_URL=

# Google Analytics measurement ID (optional), e.g. G-XXXXXXXXXX
VITE_ANALYTICS_TAG=

# Expose game instance on window.game (debug only)
VITE_GAME_PUBLIC=

# Use compressed KTX textures / assets in production
VITE_COMPRESSED=1

# Force WebGL backend (default is already WebGL-safe). Set 1/true to force.
VITE_FORCE_WEBGL=

# Opt into WebGPU backend (may crash on some Chrome builds with drawIndexed)
VITE_FORCE_WEBGPU=

# Optional day/year cycle overrides (0..1)
VITE_DAY_CYCLE_PROGRESS=
VITE_YEAR_CYCLE_PROGRESS=

# Max whisper messages when server is online
VITE_WHISPERS_COUNT=30

# Background music
VITE_MUSIC=1

# Print branded console banner on load (set 0/empty in production)
VITE_LOG=0

# Optional spawn override, e.g. 0,0
VITE_PLAYER_SPAWN=
